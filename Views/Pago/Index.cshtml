@model IEnumerable<InmobiliariaCC2.Models.Pago>

@{
    ViewData["Title"] = "Pagos de la Reserva";

    var reserva = ViewBag.Reserva as InmobiliariaCC2.Models.Reserva;

    decimal totalPagado = ViewBag.TotalPagado ?? 0m;
    decimal saldoPendiente = ViewBag.SaldoPendiente ?? 0m;

    decimal montoTotal =
        reserva?.MontoTotal ?? 0m;

    decimal montoMinimo =
        reserva?.MontoMinimoReserva ?? 0m;
}

<h2>Pagos de la Reserva</h2>


@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Mensaje"]

        <button type="button" class="btn-close" data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button type="button" class="btn-close" data-bs-dismiss="alert">
        </button>

    </div>
}


@if (reserva != null)
{
    <div class="card mb-4">

        <div class="card-header">

            <strong>
                Reserva N.º @reserva.IdReserva
            </strong>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Inquilino</strong>

                    <p>
                        @reserva.Inquilino?.Nombre
                        @reserva.Inquilino?.Apellido
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Inmueble</strong>

                    <p>
                        @reserva.Inmueble?.Direccion
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Período</strong>

                    <p>
                        @reserva.FechaDesde.ToString("dd/MM/yyyy")
                        -
                        @reserva.FechaHasta.ToString("dd/MM/yyyy")
                    </p>

                </div>

            </div>


            <hr />


            <div class="row">

                <div class="col-md-3">

                    <strong>Monto Total</strong>

                    <p class="fs-5">
                        @montoTotal.ToString("C")
                    </p>

                </div>


                <div class="col-md-3">

                    <strong>Mínimo Reserva</strong>

                    <p class="fs-5">
                        @montoMinimo.ToString("C")
                    </p>

                </div>


                <div class="col-md-3">

                    <strong>Total Pagado</strong>

                    <p class="fs-5 text-success">
                        @totalPagado.ToString("C")
                    </p>

                </div>


                <div class="col-md-3">

                    <strong>Saldo Pendiente</strong>

                    <p class="fs-5 text-danger">
                        @saldoPendiente.ToString("C")
                    </p>

                </div>

            </div>


            @if (totalPagado >= montoTotal && montoTotal > 0)
            {
                <div class="alert alert-success mb-0">

                    <strong>Pago completo.</strong>

                    La reserva se encuentra totalmente pagada.

                </div>
            }
            else if (totalPagado >= montoMinimo && montoMinimo > 0)
            {
                <div class="alert alert-success mb-0">

                    <strong>Monto mínimo alcanzado.</strong>

                    La seña requerida para la reserva está cubierta.

                </div>
            }
            else
            {
                decimal faltaParaMinimo =
                    montoMinimo - totalPagado;

                if (faltaParaMinimo < 0)
                {
                    faltaParaMinimo = 0;
                }

                <div class="alert alert-warning mb-0">

                    <strong>Pendiente de seña.</strong>

                    Faltan

                    <strong>
                        @faltaParaMinimo.ToString("C")
                    </strong>

                    para alcanzar el monto mínimo.

                </div>
            }

        </div>

    </div>
}


@if (reserva != null && saldoPendiente > 0)
{
    <p>

        <a asp-action="Create" asp-route-idReserva="@reserva.IdReserva" class="btn btn-primary">

            Registrar Nuevo Pago

        </a>

    </p>
}


@if (Model.Any())
{
    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>

                <th>#</th>

                <th>Fecha</th>

                <th>Monto</th>

                <th>Medio de Pago</th>

                <th>Observación</th>

                <th>Acciones</th>

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.IdPago
                    </td>

                    <td>
                        @item.FechaPago.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        <strong>
                            @item.Monto.ToString("C")
                        </strong>
                    </td>

                    <td>
                        @item.MedioPago
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.Observacion)
                            ? "-"
                            : item.Observacion)
                    </td>

                    <td>

                        <form asp-action="Anular" asp-route-id="@item.IdPago" method="post" class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Está seguro que desea anular este pago?');">

                                Anular

                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="alert alert-info">

        Esta reserva todavía no registra pagos.

    </div>
}


<a asp-controller="Reserva" asp-action="Index" class="btn btn-secondary">

    Volver a Reservas

</a>