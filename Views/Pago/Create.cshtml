@model InmobiliariaCC2.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";

    var reserva =
        ViewBag.Reserva as InmobiliariaCC2.Models.Reserva;

    decimal montoAlquiler =
        ViewBag.MontoAlquiler ??
        (reserva?.MontoTotal ?? 0m);

    decimal multa =
        ViewBag.Multa ?? 0m;

    decimal montoTotalAdeudado =
        ViewBag.MontoTotalAdeudado ??
        (montoAlquiler + multa);

    decimal montoMinimo =
        ViewBag.MontoMinimo ?? 0m;

    decimal totalPagado =
        ViewBag.TotalPagado ?? 0m;

    decimal saldoPendiente =
        ViewBag.SaldoPendiente ?? 0m;

    decimal faltaParaMinimo =
        ViewBag.FaltaParaMinimo ?? 0m;
}


<h2>Registrar Pago</h2>


@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger" asp-validation-summary="All">
    </div>
}


@if (reserva != null)
{
    <div class="card mb-4">

        <div class="card-header">

            <strong>
                Resumen de la Reserva N.º @reserva.IdReserva
            </strong>

        </div>


        <div class="card-body">

            <div class="row">

                <!-- DATOS DE LA RESERVA -->

                <div class="col-md-6">

                    <p>

                        <strong>
                            Inquilino:
                        </strong>

                        <br />

                        @reserva.Inquilino?.Nombre
                        @reserva.Inquilino?.Apellido

                    </p>


                    <p>

                        <strong>
                            Inmueble:
                        </strong>

                        <br />

                        @reserva.Inmueble?.Direccion

                    </p>


                    <p>

                        <strong>
                            Período:
                        </strong>

                        <br />

                        @reserva.FechaDesde.ToString("dd/MM/yyyy")

                        al

                        @reserva.FechaHasta.ToString("dd/MM/yyyy")

                    </p>


                    @if (reserva.FechaTerminacionAnticipada.HasValue)
                    {
                        <p>

                            <strong>
                                Fecha real de salida:
                            </strong>

                            <br />

                            @reserva.FechaTerminacionAnticipada
                            .Value
                            .ToString("dd/MM/yyyy")

                        </p>
                    }

                </div>


                <!-- RESUMEN FINANCIERO -->

                <div class="col-md-6">

                    <p>

                        <strong>
                            Monto del alquiler:
                        </strong>

                        <br />

                        @montoAlquiler.ToString("C")

                    </p>


                    @if (multa > 0)
                    {
                        <p>

                            <strong>
                                Multa por terminación anticipada:
                            </strong>

                            <br />

                            <span class="text-warning">

                                @multa.ToString("C")

                            </span>

                        </p>
                    }


                    <p>

                        <strong>
                            Total adeudado:
                        </strong>

                        <br />

                        <span class="fw-bold">

                            @montoTotalAdeudado.ToString("C")

                        </span>

                    </p>


                    <p>

                        <strong>
                            Monto mínimo para reservar:
                        </strong>

                        <br />

                        @montoMinimo.ToString("C")

                    </p>


                    <p>

                        <strong>
                            Total pagado:
                        </strong>

                        <br />

                        <span class="text-success">

                            @totalPagado.ToString("C")

                        </span>

                    </p>


                    <p>

                        <strong>
                            Saldo pendiente:
                        </strong>

                        <br />

                        <span class="text-danger">

                            @saldoPendiente.ToString("C")

                        </span>

                    </p>

                </div>

            </div>


            <!-- MENSAJE DEL ESTADO -->

            @if (
                saldoPendiente <= 0 &&
                montoTotalAdeudado > 0
            )
            {
                <div class="alert alert-success mb-0">

                    <strong>
                        Pago completo.
                    </strong>

                    La reserva no posee saldo pendiente.

                </div>
            }
            else if (multa > 0)
            {
                <div class="alert alert-warning mb-0">

                    <strong>
                        Multa por terminación anticipada registrada.
                    </strong>

                    La multa correspondiente es de

                    <strong>
                        @multa.ToString("C")
                    </strong>.

                    El saldo total pendiente es

                    <strong>
                        @saldoPendiente.ToString("C")
                    </strong>.

                </div>
            }
            else if (faltaParaMinimo > 0)
            {
                <div class="alert alert-warning mb-0">

                    Faltan

                    <strong>
                        @faltaParaMinimo.ToString("C")
                    </strong>

                    para alcanzar el monto mínimo requerido
                    para confirmar la reserva.

                </div>
            }
            else
            {
                <div class="alert alert-success mb-0">

                    El monto mínimo de reserva
                    ya fue alcanzado.

                </div>
            }

        </div>

    </div>
}


<!-- FORMULARIO -->

<div class="row">

    <div class="col-md-6">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()


            <input asp-for="IdReserva" type="hidden" />


            <!-- CONCEPTO -->

            <div class="mb-3">

                <label asp-for="Concepto" class="form-label">

                    Concepto

                </label>


                <input asp-for="Concepto" class="form-control" maxlength="100"
                       placeholder="Ej.: Seña inicial, pago de alquiler, multa..." required />


                <span asp-validation-for="Concepto" class="text-danger">
                </span>

            </div>


            <!-- MONTO -->

            <div class="mb-3">

                <label asp-for="Monto" class="form-label">

                    Monto del Pago

                </label>


                <input asp-for="Monto" type="number" step="0.01" min="0.01"
                       max="@saldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       class="form-control" required />


                <span asp-validation-for="Monto" class="text-danger">
                </span>


                <div class="form-text">

                    El pago no puede superar el saldo pendiente de

                    <strong>
                        @saldoPendiente.ToString("C")
                    </strong>.

                </div>

            </div>


            <!-- MEDIO DE PAGO -->

            <div class="mb-3">

                <label asp-for="MedioPago" class="form-label">

                    Medio de Pago

                </label>


                <select asp-for="MedioPago" class="form-select" required>

                    <option value="">
                        -- Seleccionar medio de pago --
                    </option>

                    <option value="Efectivo">
                        Efectivo
                    </option>

                    <option value="Transferencia">
                        Transferencia
                    </option>

                    <option value="Tarjeta">
                        Tarjeta
                    </option>

                    <option value="Otro">
                        Otro
                    </option>

                </select>


                <span asp-validation-for="MedioPago" class="text-danger">
                </span>

            </div>


            <!-- OBSERVACION -->

            <div class="mb-3">

                <label asp-for="Observacion" class="form-label">

                    Observación

                </label>


                <textarea asp-for="Observacion" class="form-control" rows="3" maxlength="255">
                </textarea>


                <span asp-validation-for="Observacion" class="text-danger">
                </span>

            </div>


            <!-- BOTONES -->

            <button type="submit" class="btn btn-success">

                Registrar Pago

            </button>


            <a asp-action="Index" asp-route-idReserva="@Model.IdReserva" class="btn btn-secondary">

                Cancelar

            </a>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}