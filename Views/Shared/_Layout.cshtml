<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - InmobiliariaCC2</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

<header>

    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">

        <div class="container-fluid">

            <!-- =====================================================
                 LOGO / INICIO
                 ===================================================== -->

            <a class="navbar-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                InmobiliariaCC2

            </a>


            <!-- =====================================================
                 BOTÓN MENÚ RESPONSIVE
                 ===================================================== -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">


                <!-- =================================================
                     MENÚ PRINCIPAL
                     ================================================= -->

                <ul class="navbar-nav flex-grow-1">


                    @* =================================================
                       PROPIETARIOS
                       Administrador y Empleado
                       ================================================= *@

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Empleado"))
                    {
                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-area=""
                               asp-controller="Propietario"
                               asp-action="Index">

                                Propietarios

                            </a>

                        </li>
                    }


                    @* =================================================
                       INQUILINOS
                       Administrador y Empleado
                       ================================================= *@

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Empleado"))
                    {
                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-controller="Inquilino"
                               asp-action="Index">

                                Inquilinos

                            </a>

                        </li>
                    }


                    @* =================================================
                       TIPOS DE INMUEBLE
                       Solo Administrador
                       ================================================= *@

                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-area=""
                               asp-controller="TipoInmueble"
                               asp-action="Index">

                                Tipos de Inmueble

                            </a>

                        </li>
                    }


                    @* =================================================
                       INMUEBLES
                       Acceso público según implementación actual
                       ================================================= *@

                    <li class="nav-item">

                        <a class="nav-link text-light"
                           asp-area=""
                           asp-controller="Inmueble"
                           asp-action="Index">

                            Inmuebles

                        </a>

                    </li>


                    @* =================================================
                       RESERVAS
                       ================================================= *@

                    <li class="nav-item">

                        <a class="nav-link text-light"
                           asp-area=""
                           asp-controller="Reserva"
                           asp-action="Index">

                            Reservas

                        </a>

                    </li>


                    @* =================================================
                       SOLICITUDES DE RESERVA
                       Administrador y Empleado
                       ================================================= *@

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Empleado"))
                    {
                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-area=""
                               asp-controller="SolicitudReserva"
                               asp-action="Index">

                                Solicitudes

                            </a>

                        </li>
                    }

                </ul>


                <!-- =================================================
                     SECTOR DE USUARIO
                     ================================================= -->

                <ul class="navbar-nav">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        @* =============================================
                           MI PERFIL
                           Disponible para cualquier usuario autenticado
                           ============================================= *@

                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-controller="Usuario"
                               asp-action="Perfil">

                                Mi Perfil

                            </a>

                        </li>


                        @* =============================================
                           USUARIO Y ROL
                           ============================================= *@

                        <li class="nav-item">

                            <span class="nav-link text-light">

                               @{
    var avatarUsuario = User.FindFirst("Avatar")?.Value;
    var rolUsuario = User.FindFirst(
        System.Security.Claims.ClaimTypes.Role
    )?.Value;
}

<div class="d-flex align-items-center gap-2">

    @if (!string.IsNullOrWhiteSpace(avatarUsuario))
    {
        <img src="@avatarUsuario"
             alt="Avatar"
             class="rounded-circle border"
             style="width: 36px;
                    height: 36px;
                    object-fit: cover;" />
    }
    else
    {
        <div class="rounded-circle bg-secondary text-white
                    d-flex align-items-center justify-content-center"
             style="width: 36px;
                    height: 36px;
                    font-size: 15px;
                    font-weight: bold;">

            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")

        </div>
    }

    <span>
        Hola, @User.Identity?.Name (@rolUsuario)
    </span>

</div>

                            </span>

                        </li>


                        @* =============================================
                           CERRAR SESIÓN
                           ============================================= *@

                        <li class="nav-item">

                            <form asp-controller="Usuario"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-link nav-link text-light">

                                    Cerrar sesión

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {

                        @* =============================================
                           INICIAR SESIÓN
                           ============================================= *@

                        <li class="nav-item">

                            <a class="nav-link text-light"
                               asp-controller="Usuario"
                               asp-action="Login">

                                Iniciar sesión

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

</header>



<div class="container">

    <main role="main" class="pb-3">

        @RenderBody()

    </main>

</div>


<footer class="border-top footer text-muted">

    <div class="container">

        &copy; 2026 - InmobiliariaCC2 - Alquileres Temporales

    </div>

</footer>



<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>