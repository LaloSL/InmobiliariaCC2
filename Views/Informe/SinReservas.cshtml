@model IEnumerable<InmobiliariaCC2.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles sin reservas";
}

<h2>Inmuebles sin reservas</h2>

<p class="text-muted">
    Inmuebles que no registraron reservas
    durante el período indicado.
</p>

<form asp-action="SinReservas"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-4">

        <label for="dias"
               class="form-label">
            Cantidad de días
        </label>

        <input type="number"
               id="dias"
               name="dias"
               value="@ViewBag.Dias"
               min="1"
               class="form-control"
               required />

    </div>

    <div class="col-md-3 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary">
            Consultar
        </button>

    </div>

</form>

<div class="alert alert-secondary">
    Período consultado:
    <strong>@ViewBag.Dias días</strong>
</div>

<div class="table-responsive">

    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Inmueble</th>
                <th>Propietario</th>
                <th>Precio por día</th>
                <th>Última reserva</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Propietario
                    </td>

                    <td>
                        @item.PrecioDia.ToString("C")
                    </td>

                    <td>
                        @if (item.UltimaReserva.HasValue)
                        {
                            @item.UltimaReserva.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">
                                Nunca tuvo reservas
                            </span>
                        }
                    </td>

                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                No disponible
                            </span>
                        }
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron inmuebles sin reservas
        durante los últimos @ViewBag.Dias días.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Volver a Informes
</a>