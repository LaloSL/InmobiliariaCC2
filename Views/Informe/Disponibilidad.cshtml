@model IEnumerable<InmobiliariaCC2.Models.InformeInmueble>

@{
    ViewData["Title"] = "Disponibilidad de Inmuebles";

    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;

    bool consultaRealizada =
        ViewBag.ConsultaRealizada != null &&
        (bool)ViewBag.ConsultaRealizada;
}

<h2>Disponibilidad de Inmuebles</h2>

<p class="text-muted">
    Permite consultar los inmuebles disponibles
    para un período determinado.
</p>

<form asp-controller="Informe"
      asp-action="Disponibilidad"
      method="get"
      class="mt-4">

    <div class="row align-items-end">

        <div class="col-md-4 mb-3">

            <label for="fechaDesde"
                   class="form-label">
                Fecha Desde
            </label>

            <input type="date"
                   id="fechaDesde"
                   name="fechaDesde"
                   class="form-control"
                   value="@(fechaDesde?.ToString("yyyy-MM-dd"))"
                   required />

        </div>

        <div class="col-md-4 mb-3">

            <label for="fechaHasta"
                   class="form-label">
                Fecha Hasta
            </label>

            <input type="date"
                   id="fechaHasta"
                   name="fechaHasta"
                   class="form-control"
                   value="@(fechaHasta?.ToString("yyyy-MM-dd"))"
                   required />

        </div>

        <div class="col-md-4 mb-3">

            <button type="submit"
                    class="btn btn-primary">
                Consultar Disponibilidad
            </button>

        </div>

    </div>

</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (consultaRealizada)
{
    <div class="alert alert-secondary mt-2">

        Período consultado:

        <strong>
            @fechaDesde?.ToString("dd/MM/yyyy")
            -
            @fechaHasta?.ToString("dd/MM/yyyy")
        </strong>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="alert alert-success">
            Se encontraron
            <strong>@Model.Count()</strong>
            inmueble(s) disponible(s).
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">

                    <tr>
                        <th>Inmueble</th>
                        <th>Propietario</th>
                        <th>Precio por Día</th>
                        <th>Estado</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var inmueble in Model)
                    {
                        <tr>

                            <td>
                                @inmueble.Direccion
                            </td>

                            <td>
                                @inmueble.Propietario
                            </td>

                            <td>
                                @inmueble.PrecioDia.ToString("C")
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Disponible
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-warning">

            No se encontraron inmuebles disponibles
            para el período seleccionado.

        </div>
    }
}

<div class="mt-3">

    <a asp-controller="Informe"
       asp-action="Index"
       class="btn btn-secondary">

        Volver a Informes

    </a>

</div>