@model IEnumerable<InmobiliariaCC2.Models.InformeReserva>

@{
    ViewData["Title"] = "Próximos Vencimientos";

    int dias = ViewBag.Dias != null
        ? Convert.ToInt32(ViewBag.Dias)
        : 7;
}

<h2>Próximos Vencimientos</h2>

<p class="text-muted">
    Reservas activas que finalizan dentro de los próximos días.
</p>

<form asp-controller="Informe"
      asp-action="ProximosVencimientos"
      method="get"
      class="row g-3 align-items-end mt-2 mb-4">

    <div class="col-md-4">

        <label for="dias"
               class="form-label">
            Cantidad de días
        </label>

        <input type="number"
               id="dias"
               name="dias"
               value="@dias"
               min="1"
               class="form-control" />

    </div>

    <div class="col-md-auto">

        <button type="submit"
                class="btn btn-primary">
            Consultar
        </button>

    </div>

</form>

<div class="alert alert-secondary">
    Período consultado:
    <strong>próximos @dias días</strong>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No existen reservas que finalicen dentro
        de los próximos @dias días.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">

                <tr>
                    <th>Reserva</th>
                    <th>Inquilino</th>
                    <th>Inmueble</th>
                    <th>Fecha Desde</th>
                    <th>Fecha Hasta</th>
                    <th>Precio por Día</th>
                    <th>Días Restantes</th>
                    <th>Estado</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            N.º @item.IdReserva
                        </td>

                        <td>
                            @item.Inquilino
                        </td>

                        <td>
                            @item.Inmueble
                        </td>

                        <td>
                            @item.FechaDesde.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.FechaHasta.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.MontoDia.ToString("C2")
                        </td>

                        <td>
                            @if (item.DiasRestantes == 0)
                            {
                                <span class="badge bg-danger">
                                    Finaliza hoy
                                </span>
                            }
                            else if (item.DiasRestantes == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                    1 día
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.DiasRestantes días
                                </span>
                            }
                        </td>

                        <td>
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactiva
                                </span>
                            }
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<div class="mt-3">

    <a asp-controller="Informe"
       asp-action="Index"
       class="btn btn-secondary">
        Volver a Informes
    </a>

</div>