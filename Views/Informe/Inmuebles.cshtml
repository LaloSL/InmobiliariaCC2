@model IEnumerable<InmobiliariaCC2.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles y Estado";

    string estadoActual =
        ViewBag.Estado?.ToString()
        ?? "todos";
}

<h2>Inmuebles y Estado</h2>

<p class="text-muted">
    Listado de inmuebles registrados con su propietario,
    precio por día y estado actual.
</p>

<form method="get"
      asp-controller="Informe"
      asp-action="Inmuebles"
      class="row g-3 align-items-end mt-2 mb-4">

    <div class="col-md-4">

        <label class="form-label">
            Estado del inmueble
        </label>

        <select name="estado"
                class="form-select">

            <option value="todos"
                    selected="@(estadoActual == "todos")">
                Todos
            </option>

            <option value="disponibles"
                    selected="@(estadoActual == "disponibles")">
                Disponibles
            </option>

            <option value="nodisponibles"
                    selected="@(estadoActual == "nodisponibles")">
                No disponibles
            </option>

        </select>

    </div>

    <div class="col-md-auto">

        <button type="submit"
                class="btn btn-primary">
            Consultar
        </button>

    </div>

</form>

<div class="alert alert-secondary">

    @if (estadoActual == "disponibles")
    {
        <span>
            Mostrando:
            <strong>inmuebles disponibles</strong>
        </span>
    }
    else if (estadoActual == "nodisponibles")
    {
        <span>
            Mostrando:
            <strong>inmuebles no disponibles</strong>
        </span>
    }
    else
    {
        <span>
            Mostrando:
            <strong>todos los inmuebles</strong>
        </span>
    }

</div>

@if (Model.Any())
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Inmueble</th>
                    <th>Propietario</th>
                    <th>Precio por Día</th>
                    <th>Estado</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.Direccion
                        </td>

                        <td>
                            @item.Propietario
                        </td>

                        <td>
                            @item.PrecioDia.ToString("C2")
                        </td>

                        <td>

                            @if (item.Estado)
                            {
                                <span class="badge bg-success">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    No disponible
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
else
{
    <div class="alert alert-warning">

        No se encontraron inmuebles
        para el estado seleccionado.

    </div>
}

<a asp-controller="Informe"
   asp-action="Index"
   class="btn btn-secondary mt-2">

    Volver a Informes

</a>