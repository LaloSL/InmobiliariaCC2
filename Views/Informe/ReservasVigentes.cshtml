@model IEnumerable<InmobiliariaCC2.Models.InformeReserva>

@{
    ViewData["Title"] = "Reservas Vigentes";
}

<h2>Reservas Vigentes</h2>

<p class="text-muted">
    Reservas activas cuyo período de alquiler incluye la fecha actual.
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info mt-4">
        No existen reservas vigentes en la fecha actual.
    </div>
}
else
{
    <div class="table-responsive mt-4">

        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Reserva</th>
                    <th>Inquilino</th>
                    <th>Inmueble</th>
                    <th>Fecha Desde</th>
                    <th>Fecha Hasta</th>
                    <th>Precio por Día</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            N.º @item.IdReserva
                        </td>

                        <td>
                            @item.Inquilino
                        </td>

                        <td>
                            @item.Inmueble
                        </td>

                        <td>
                            @item.FechaDesde.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.FechaHasta.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.MontoDia.ToString("C2")
                        </td>

                        <td>
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactiva
                                </span>
                            }
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<div class="mt-3">

    <a asp-controller="Informe"
       asp-action="Index"
       class="btn btn-secondary">
        Volver a Informes
    </a>

</div>