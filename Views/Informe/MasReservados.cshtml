@model IEnumerable<InmobiliariaCC2.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles más reservados";
}

<h2>Inmuebles más reservados</h2>

<p class="text-muted">
    Reservas registradas durante los últimos
    @ViewBag.Dias días.
</p>

<div class="table-responsive mt-3">

    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Posición</th>
                <th>Inmueble</th>
                <th>Propietario</th>
                <th>Precio por día</th>
                <th>Reservas</th>
                <th>Última reserva</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>

            @{
                int posicion = 1;
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @posicion
                    </td>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Propietario
                    </td>

                    <td>
                        @item.PrecioDia.ToString("C")
                    </td>

                    <td>
                        <strong>
                            @item.CantidadReservas
                        </strong>
                    </td>

                    <td>
                        @if (item.UltimaReserva.HasValue)
                        {
                            @item.UltimaReserva.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                No disponible
                            </span>
                        }
                    </td>
                </tr>

                posicion++;
            }

        </tbody>

    </table>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron reservas durante
        los últimos @ViewBag.Dias días.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Volver a Informes
</a>