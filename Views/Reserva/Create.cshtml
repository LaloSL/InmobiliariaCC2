@model InmobiliariaCC2.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h2>Registrar Reserva</h2>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="row">
    <div class="col-md-8">

        <form asp-action="Create" method="post">

            <!-- INQUILINO -->
            <div class="mb-3">
                <label asp-for="IdInquilino" class="form-label">
                    Inquilino
                </label>

                <select asp-for="IdInquilino" class="form-select" asp-items="ViewBag.Inquilinos" required>

                    <option value="">
                        -- Seleccionar Inquilino --
                    </option>

                </select>

                <span asp-validation-for="IdInquilino" class="text-danger">
                </span>
            </div>


            <!-- TIPO DE INMUEBLE -->
            <div class="mb-3">
                <label class="form-label">
                    Tipo de Inmueble
                </label>

                <select id="IdTipo" name="idTipo" class="form-select" asp-items="ViewBag.Tipos" required>

                    <option value="">
                        -- Seleccionar Tipo --
                    </option>

                </select>
            </div>


            <!-- INMUEBLE -->
            <div class="mb-3">
                <label asp-for="IdInmueble" class="form-label">
                    Inmueble
                </label>

                <select asp-for="IdInmueble" id="IdInmueble" class="form-select" asp-items="ViewBag.Inmuebles" required>

                    <option value="">
                        -- Seleccionar Inmueble --
                    </option>

                </select>

                <span asp-validation-for="IdInmueble" class="text-danger">
                </span>

                <div class="form-text">
                    Se muestra la dirección, capacidad y precio por día del inmueble.
                </div>
            </div>


            <!-- FECHA DESDE -->
            <div class="mb-3">
                <label asp-for="FechaDesde" class="form-label">
                    Fecha Desde
                </label>

                <input asp-for="FechaDesde" id="FechaDesde" type="date" class="form-control" required />

                <span asp-validation-for="FechaDesde" class="text-danger">
                </span>
            </div>


            <!-- FECHA HASTA -->
            <div class="mb-3">
                <label asp-for="FechaHasta" class="form-label">
                    Fecha Hasta
                </label>

                <input asp-for="FechaHasta" id="FechaHasta" type="date" class="form-control" required />

                <span asp-validation-for="FechaHasta" class="text-danger">
                </span>
            </div>


            <!-- ============================================= -->
            <!-- RESUMEN ECONÓMICO -->
            <!-- ============================================= -->

            <div id="resumenReserva" class="card mb-4" style="display:none;">

                <div class="card-header">
                    <strong>Resumen de la Reserva</strong>
                </div>

                <div class="card-body">

                    <div class="row mb-2">
                        <div class="col-md-6">
                            Precio por día:
                        </div>

                        <div class="col-md-6">
                            <strong id="precioDiaTexto"></strong>
                        </div>
                    </div>


                    <div class="row mb-2">
                        <div class="col-md-6">
                            Porcentaje de reserva:
                        </div>

                        <div class="col-md-6">
                            <strong id="porcentajeTexto"></strong>
                        </div>
                    </div>


                    <div class="row mb-2">
                        <div class="col-md-6">
                            Cantidad de días:
                        </div>

                        <div class="col-md-6">
                            <strong id="cantidadDiasTexto"></strong>
                        </div>
                    </div>

                    <hr />


                    <div class="row mb-2">
                        <div class="col-md-6">
                            Monto total:
                        </div>

                        <div class="col-md-6">
                            <strong id="montoTotalTexto"></strong>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6">
                            Monto mínimo para reservar:
                        </div>

                        <div class="col-md-6">
                            <strong id="montoMinimoTexto" class="text-success">
                            </strong>
                        </div>
                    </div>

                </div>
            </div>


            <button type="submit" class="btn btn-success">
                Confirmar Reserva
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>
</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const tipoSelect =
            document.getElementById("IdTipo");

        const inmuebleSelect =
            document.getElementById("IdInmueble");

        const fechaDesde =
            document.getElementById("FechaDesde");

        const fechaHasta =
            document.getElementById("FechaHasta");


        const resumenReserva =
            document.getElementById("resumenReserva");

        const precioDiaTexto =
            document.getElementById("precioDiaTexto");

        const porcentajeTexto =
            document.getElementById("porcentajeTexto");

        const cantidadDiasTexto =
            document.getElementById("cantidadDiasTexto");

        const montoTotalTexto =
            document.getElementById("montoTotalTexto");

        const montoMinimoTexto =
            document.getElementById("montoMinimoTexto");


        // =====================================================
        // FORMATEAR DINERO
        // =====================================================

        function formatearDinero(valor) {

            return Number(valor).toLocaleString(
                "es-AR",
                {
                    style: "currency",
                    currency: "ARS"
                }
            );
        }


        // =====================================================
        // CALCULAR RESUMEN ECONÓMICO
        // =====================================================

        function calcularReserva() {

            const opcion =
                inmuebleSelect.options[
                inmuebleSelect.selectedIndex
                ];


            if (!opcion ||
                !opcion.value ||
                !fechaDesde.value ||
                !fechaHasta.value) {

                resumenReserva.style.display = "none";

                return;
            }


            const precioDia =
                Number(opcion.dataset.precioDia);

            const porcentaje =
                Number(opcion.dataset.porcentajeReserva);


            const desde =
                new Date(fechaDesde.value + "T00:00:00");

            const hasta =
                new Date(fechaHasta.value + "T00:00:00");


            const diferencia =
                hasta - desde;


            const cantidadDias =
                Math.round(
                    diferencia /
                    (1000 * 60 * 60 * 24)
                );


            if (cantidadDias <= 0 ||
                precioDia <= 0 ||
                porcentaje <= 0) {

                resumenReserva.style.display = "none";

                return;
            }


            const montoTotal =
                cantidadDias * precioDia;


            const montoMinimo =
                montoTotal * porcentaje / 100;


            precioDiaTexto.textContent =
                formatearDinero(precioDia);


            porcentajeTexto.textContent =
                porcentaje.toLocaleString("es-AR") + " %";


            cantidadDiasTexto.textContent =
                cantidadDias;


            montoTotalTexto.textContent =
                formatearDinero(montoTotal);


            montoMinimoTexto.textContent =
                formatearDinero(montoMinimo);


            resumenReserva.style.display = "block";
        }


        // =====================================================
        // CARGAR INMUEBLES SEGÚN TIPO
        // =====================================================

        tipoSelect.addEventListener(
            "change",
            async function () {

                const idTipo =
                    this.value;


                inmuebleSelect.innerHTML =
                    '<option value="">-- Seleccionar Inmueble --</option>';


                resumenReserva.style.display =
                    "none";


                if (!idTipo) {
                    return;
                }


                try {

                    const respuesta =
                        await fetch(
                            `/Reserva/ObtenerInmueblesPorTipo?idTipo=${idTipo}`
                        );


                    if (!respuesta.ok) {

                        throw new Error(
                            "No se pudieron cargar los inmuebles."
                        );
                    }


                    const inmuebles =
                        await respuesta.json();


                    if (inmuebles.length === 0) {

                        const option =
                            document.createElement("option");

                        option.value = "";

                        option.textContent =
                            "No hay inmuebles de este tipo";

                        inmuebleSelect.appendChild(option);

                        return;
                    }


                    inmuebles.forEach(
                        inmueble => {

                            const option =
                                document.createElement("option");


                            option.value =
                                inmueble.idInmueble;


                            // Guardamos estos datos solamente
                            // para realizar el cálculo visual.
                            option.dataset.precioDia =
                                inmueble.precioDia;

                            option.dataset.porcentajeReserva =
                                inmueble.porcentajeReserva;


                            const precio =
                                formatearDinero(
                                    inmueble.precioDia
                                );


                            option.textContent =
                                `${inmueble.direccion} | ` +
                                `Capacidad: ${inmueble.cupo} personas | ` +
                                `${precio} por día`;


                            inmuebleSelect.appendChild(option);
                        }
                    );

                }
                catch (error) {

                    console.error(error);


                    const option =
                        document.createElement("option");

                    option.value = "";

                    option.textContent =
                        "Error al cargar los inmuebles";

                    inmuebleSelect.appendChild(option);
                }
            }
        );


        // =====================================================
        // RECALCULAR CUANDO CAMBIA ALGÚN DATO
        // =====================================================

        inmuebleSelect.addEventListener(
            "change",
            calcularReserva
        );


        fechaDesde.addEventListener(
            "change",
            calcularReserva
        );


        fechaHasta.addEventListener(
            "change",
            calcularReserva
        );

    </script>
}