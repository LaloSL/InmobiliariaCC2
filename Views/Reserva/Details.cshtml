@model InmobiliariaCC2.Models.Reserva

@{
    ViewData["Title"] = "Detalles de la Reserva";
}

<h2>Detalles de la Reserva #@Model.IdReserva</h2>

<div class="card mb-3">
    <div class="card-header bg-primary text-white">
        <strong>Información General de la Reserva</strong>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Fecha Desde</dt>
            <dd class="col-sm-9">@Model.FechaDesde.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Fecha Hasta</dt>
            <dd class="col-sm-9">@Model.FechaHasta.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Monto Diario</dt>
            <dd class="col-sm-9">$@Model.MontoDia</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Estado ? "bg-success" : "bg-danger")">
                    @(Model.Estado ? "Activa" : "Inactiva/Anulada")
                </span>
            </dd>
        </dl>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <strong>Datos del Inquilino</strong>
            </div>
            <div class="card-body">
                <p><strong>Nombre:</strong> @Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</p>
                <p><strong>Email:</strong> @Model.Inquilino?.Email</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <strong>Datos del Inmueble</strong>
            </div>
            <div class="card-body">
                <p><strong>Dirección:</strong> @Model.Inmueble?.Direccion</p>
                <p><strong>Precio Base/Día:</strong> $@Model.Inmueble?.PrecioDia</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>