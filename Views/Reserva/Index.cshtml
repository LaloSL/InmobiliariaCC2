@model IEnumerable<InmobiliariaCC2.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";

    bool esPersonal =
        User.IsInRole("Administrador") ||
        User.IsInRole("Empleado");
}

<h2>Listado de Reservas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


@if (esPersonal)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Nueva Reserva
        </a>
    </p>
}


<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>

            @if (esPersonal)
            {
                <th>#</th>
                <th>Inquilino</th>
            }

            <th>Inmueble</th>
            <th>Desde</th>
            <th>Hasta</th>

            @if (esPersonal)
            {
                <th>Estado</th>
                <th>Acciones</th>
            }

        </tr>
    </thead>


    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                @if (esPersonal)
                {
                    <td>
                        @item.IdReserva
                    </td>

                    <td>
                        @item.Inquilino?.Nombre
                        @item.Inquilino?.Apellido
                    </td>
                }


                <td>
                    @item.Inmueble?.Direccion
                </td>


                <td>
                    @item.FechaDesde.ToString("dd/MM/yyyy")
                </td>


                <td>
                    @item.FechaHasta.ToString("dd/MM/yyyy")
                </td>


                @if (esPersonal)
                {
                    <td>
                        <span class="badge @(item.Estado ? "bg-success" : "bg-secondary")">

                            @(item.Estado
                                ? "Activa"
                                : "Finalizada/Anulada")

                        </span>
                    </td>


                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.IdReserva"
                           class="btn btn-sm btn-info">

                            Detalles

                        </a>


                        @if (item.Estado)
                        {
                            <a asp-action="FinalizarAnticipadamente"
                               asp-route-id="@item.IdReserva"
                               class="btn btn-sm btn-warning">

                                Salida Anticipada

                            </a>
                        }

                    </td>
                }

            </tr>
        }

    </tbody>

</table>