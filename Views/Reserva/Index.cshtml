@model IEnumerable<InmobiliariaCC2.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";

    bool usuarioInterno =
        User.IsInRole("Administrador") ||
        User.IsInRole("Empleado");

    Dictionary<int, decimal>? resumenPagos = null;

    if (usuarioInterno &&
        ViewBag.ResumenPagos != null)
    {
        resumenPagos =
            ViewBag.ResumenPagos
            as Dictionary<int, decimal>;

    }

    <h2>Listado de Reservas</h2>


    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert">
            </button>
        </div>
    }


    @if (usuarioInterno)
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">

                Crear Nueva Reserva

            </a>
        </p>
    }


    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>

                @if (usuarioInterno)


                {
                    <th>#</th>
                    <th>Inquilino</th>
                }

                <th>Inmueble</th>
                <th>Desde</th>
                <th>Hasta</th>

                @if (usuarioInterno)
                {
                    <th>Total</th>
                    <th>Pagado</th>
                    <th>Saldo</th>
                    <th>Estado Pago</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                }

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                decimal totalPagado = 0m;

                if (usuarioInterno &&
                    resumenPagos != null &&
                    resumenPagos.ContainsKey(item.IdReserva))
                {
                    totalPagado =
                        resumenPagos[item.IdReserva];
                }


                decimal montoTotal =
                    item.MontoTotal;


                decimal montoMinimo =
                    item.MontoMinimoReserva;


                decimal saldo =
                    montoTotal - totalPagado;


                if (saldo < 0)
                {
                    saldo = 0;
                }


                <tr>

                    @if (usuarioInterno)

                    {
                        <td>
                            @item.IdReserva
                        </td>

                        <td>
                            @item.Inquilino?.Nombre
                            @item.Inquilino?.Apellido
                        </td>
                    }


                    <td>
                        @item.Inmueble?.Direccion
                    </td>


                    <td>
                        @item.FechaDesde.ToString("dd/MM/yyyy")
                    </td>


                    <td>
                        @item.FechaHasta.ToString("dd/MM/yyyy")
                    </td>


                    @if (usuarioInterno)
                    {
                        <!-- MONTO TOTAL -->
                        <td>
                            @montoTotal.ToString("C")
                        </td>

                        <!-- TOTAL PAGADO -->
                        <td class="text-success">
                            @totalPagado.ToString("C")
                        </td>

                        <!-- SALDO -->
                        <td class="text-danger">
                            @saldo.ToString("C")
                        </td>

                        <!-- ESTADO FINANCIERO -->
                        <td>
                            @if (montoTotal > 0 && totalPagado >= montoTotal)
                            {
                                <span class="badge bg-primary">
                                    Pago completo
                                </span>
                            }
                            else if (montoMinimo > 0 && totalPagado >= montoMinimo)
                            {
                                <span class="badge bg-success">
                                    Seña cubierta
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendiente de seña
                                </span>
                            }
                        </td>

                        <!-- ESTADO DE LA RESERVA -->
                        <td>
                            <span class="badge @(item.Estado ? "bg-success" : "bg-secondary")">
                                @(item.Estado
                                    ? "Activa"
                                    : "Finalizada/Anulada")
                            </span>
                        </td>

                        <!-- ACCIONES -->
                        <td>
                            <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info">
                                Detalles
                            </a>

                            <a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@item.IdReserva"
                               class="btn btn-sm btn-success">
                                Pagos
                            </a>

                            @if (item.Estado)
                            {
                                <a asp-action="FinalizarAnticipadamente" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning">
                                    Salida Anticipada
                                </a>
                            }

                            Salida Anticipada

                        </a>
                    }

                    @if (usuarioInterno)
                    {
                        <p>
                            <a asp-action="Create" class="btn btn-primary">
                                Crear Nueva Reserva
                            </a>
                        </p>
                    }
                    else
                    {
                        <p>
                            <a asp-controller="Inmueble" asp-action="BuscarDisponibles" class="btn btn-primary">
                                Nueva Solicitud de Reserva
                            </a>
                        </p>
                    }

                </td>
            }

        </tr>
    }

</tbody>

</table>