@model InmobiliariaCC2.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
}

<h1>Detalles del Inmueble</h1>

<div>
    <h4>Inmueble</h4>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Direccion)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cupo)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cupo)</dd>

                <dt class="col-sm-4">Tipo</dt>
                <dd class="col-sm-8">@Model.Tipo?.Nombre</dd>

                <dt class="col-sm-4">Propietario</dt>
                <dd class="col-sm-8">@Model.Propietario?.Nombre @Model.Propietario?.Apellido</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PrecioDia)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioDia)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Coordenadas)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Coordenadas)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Estado)</dt>
                <dd class="col-sm-8">@(Model.Estado ? "Disponible" : "Inactivo")</dd>
            </dl>
        </div>

        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Foto))
            {
                <div class="card">
                    <img src="@Model.Foto" class="card-img-top img-fluid rounded" alt="Foto del inmueble"
                         style="max-height: 350px; object-fit: cover;" />
                    <div class="card-body text-center">

                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-secondary text-center">
                    <p class="mb-0">Este inmueble no tiene foto asignada.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>