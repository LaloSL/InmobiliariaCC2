@model InmobiliariaCC2.Models.Inmueble

@{
    ViewData["Title"] = "Crear Inmueble";
}

<h2>Registrar Nuevo Inmueble</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Direccion" class="form-label">
                    Dirección
                </label>

                <input asp-for="Direccion" class="form-control" required />

                <span asp-validation-for="Direccion" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="Cupo" class="form-label">
                    Cantidad de Personas
                </label>

                <input asp-for="Cupo" type="number" class="form-control" min="1" required />

                <span asp-validation-for="Cupo" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="PrecioDia" class="form-label">
                    Precio por Día
                </label>

                <div class="input-group">
                    <span class="input-group-text">$</span>

                    <input asp-for="PrecioDia" type="number" step="0.01" min="0.01" class="form-control" required />
                </div>

                <span asp-validation-for="PrecioDia" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="PorcentajeReserva" class="form-label">
                    Porcentaje de Reserva
                </label>

                <div class="input-group">
                    <input asp-for="PorcentajeReserva" type="number" step="0.01" min="0.01" max="100"
                           class="form-control" required />

                    <span class="input-group-text">%</span>
                </div>

                <div class="form-text">
                    Porcentaje del monto total que deberá abonarse
                    para confirmar la reserva.
                </div>

                <span asp-validation-for="PorcentajeReserva" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="IdTipo" class="form-label">
                    Tipo de Inmueble
                </label>

                <select asp-for="IdTipo" class="form-select" asp-items="ViewBag.Tipos" required>

                    <option value="">
                        -- Seleccione un inmueble --
                    </option>

                </select>

                <span asp-validation-for="IdTipo" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="IdPropietario" class="form-label">
                    Propietario
                </label>

                <select asp-for="IdPropietario" class="form-select" asp-items="ViewBag.Propietarios" required>

                    <option value="">
                        -- Seleccionar Propietario --
                    </option>

                </select>

                <span asp-validation-for="IdPropietario" class="text-danger">
                </span>
            </div>


            <div class="mb-3">
                <label asp-for="FotoFile" class="form-label">
                    Foto del Inmueble
                </label>

                <input asp-for="FotoFile" type="file" class="form-control" accept="image/*" />
            </div>


            <button type="submit" class="btn btn-primary">
                Guardar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}