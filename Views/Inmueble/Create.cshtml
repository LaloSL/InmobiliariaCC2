@model InmobiliariaCC2.Models.Inmueble

@{
    ViewData["Title"] = "Crear Inmueble";
}

<h2>Registrar Nuevo Inmueble</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Direccion" class="form-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Cupo" class="form-label">Cantidad de Personas</label>
                <input asp-for="Cupo" type="number" class="form-control" min="1" required />
            </div>

            <div class="mb-3">
                <label asp-for="PrecioDia" class="form-label">Precio por Dia</label>
                <input asp-for="PrecioDia" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="IdTipo" class="form-label">Tipo de Inmueble</label>
                <select asp-for="IdTipo" class="form-select" asp-items="ViewBag.Tipos" required>
                    <option value="">-- Seleccione un inmueble --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="IdPropietario" class="form-label">Propietario</label>
                <select asp-for="IdPropietario" class="form-select" asp-items="ViewBag.Propietarios" required>
                    <option value="">-- Seleccionar Propietario --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="FotoFile" class="form-label">Foto del Inmueble</label>
                <input asp-for="FotoFile" type="file" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>