@model InmobiliariaCC2.Models.Inquilino

@{
    ViewData["Title"] = "Eliminar Inquilino";
}

<h2>Eliminar Inquilino</h2>

<p class="text-danger">¿Está seguro de que desea dar de baja a este inquilino?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Model.Dni</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre @Model.Apellido</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>

        <dt class="col-sm-2">Dirección de Origen</dt>
        <dd class="col-sm-10">@Model.DireccionOrigen</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdInquilino" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>