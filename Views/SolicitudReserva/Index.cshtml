@model IEnumerable<InmobiliariaCC2.Models.SolicitudReserva>

@{
    ViewData["Title"] = "Solicitudes de Reserva";

    var disponibilidad =
        ViewBag.Disponibilidad as Dictionary<int, bool>
        ?? new Dictionary<int, bool>();
}

<h2>Solicitudes de Reserva</h2>

<p class="text-muted">
    Solicitudes enviadas por visitantes del sitio.
</p>


@* =====================================================
   MENSAJE DE ÉXITO
   ===================================================== *@

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@* =====================================================
   MENSAJE DE ERROR
   ===================================================== *@

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (Model.Any())
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">

                <tr>

                    <th>#</th>
                    <th>Solicitante</th>
                    <th>DNI</th>
                    <th>Contacto</th>
                    <th>Inmueble</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Solicitud</th>
                    <th>Estado</th>
                    <th>Disponibilidad</th>
                    <th>Acciones</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.IdSolicitud
                        </td>


                        <td>
                            @item.Nombre @item.Apellido
                        </td>


                        <td>
                            @item.Dni
                        </td>


                        <td>

                            <div>
                                @item.Email
                            </div>

                            <div>
                                @item.Telefono
                            </div>

                        </td>


                        <td>
                            @item.Inmueble?.Direccion
                        </td>


                        <td>
                            @item.FechaDesde.ToString("dd/MM/yyyy")
                        </td>


                        <td>
                            @item.FechaHasta.ToString("dd/MM/yyyy")
                        </td>


                        <td>
                            @item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                        </td>


                        @* ==========================================
                           ESTADO DE LA SOLICITUD
                           ========================================== *@

                        <td>

                            @if (item.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendiente
                                </span>
                            }
                            else if (item.Estado == "Confirmada")
                            {
                                <span class="badge bg-success">
                                    Confirmada
                                </span>
                            }
                            else if (item.Estado == "Rechazada")
                            {
                                <span class="badge bg-danger">
                                    Rechazada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Estado
                                </span>
                            }

                        </td>


                        @* ==========================================
                           DISPONIBILIDAD DEL INMUEBLE
                           ========================================== *@

                        <td>

                            @if (item.Estado == "Pendiente")
                            {
                                bool estaDisponible =
                                    disponibilidad.ContainsKey(item.IdSolicitud)
                                    && disponibilidad[item.IdSolicitud];

                                if (estaDisponible)
                                {
                                    <span class="badge bg-success">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Fechas ocupadas
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </td>


                        @* ==========================================
                           ACCIONES
                           ========================================== *@

                        <td>

                            @if (item.Estado == "Pendiente")
                            {
                                bool puedeConfirmar =
                                    disponibilidad.ContainsKey(item.IdSolicitud)
                                    && disponibilidad[item.IdSolicitud];


                                @* ----------------------------------
                                   CONFIRMAR RESERVA
                                   ---------------------------------- *@

                                @if (puedeConfirmar)
                                {
                                    <form asp-action="ConfirmarReserva"
                                          asp-route-id="@item.IdSolicitud"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                onclick="return confirm('¿Confirma la creación de esta reserva?');">

                                            Confirmar Reserva

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled
                                            title="El inmueble posee una reserva superpuesta para estas fechas.">

                                        Confirmar Reserva

                                    </button>
                                }


                                @* ----------------------------------
                                   RECHAZAR SOLICITUD
                                   ---------------------------------- *@

                                <form asp-action="Rechazar"
                                      asp-route-id="@item.IdSolicitud"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('¿Está seguro que desea rechazar esta solicitud?');">

                                        Rechazar

                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Procesada
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
else
{
    <div class="alert alert-info">

        No hay solicitudes de reserva registradas.

    </div>
}